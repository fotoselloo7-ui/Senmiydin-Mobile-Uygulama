APP_NAME="SenMiydin?"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://senmiydin.tr
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

# Exact TLS-terminating proxy IPs/CIDRs; never use * on a publicly reachable origin.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=https://senmiydin.tr

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=senmiydin
DB_USERNAME=senmiydin
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=

FILESYSTEM_DISK=local
AVATAR_DISK=local
POST_MEDIA_DISK=local
# Voice messages (AAC/M4A). The app enforces 2 minutes / 3 MB too; raise these only together with a new app release.
VOICE_MAX_SECONDS=120
VOICE_MAX_BYTES=3145728
LOCATION_HISTORY_DAYS=7
SANCTUM_EXPIRATION=43200
SANCTUM_STATEFUL_DOMAINS=senmiydin.tr

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids

# Use log only in local/development. Secrets belong in the deployment environment.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SenMiydin?"
PUBLIC_SITE_URL=https://senmiydin.tr
PUBLIC_SUPPORT_EMAIL=destek@senmiydin.tr
PUBLIC_CONTACT_EMAIL=info@senmiydin.tr
# AdMob publisher id (pub-<16 digits>): served at /app-ads.txt.
ADMOB_PUBLISHER_ID=pub-3008758416596112
# Deep links: release signing SHA-256 fingerprint(s), comma separated, and the Apple Team ID (served only when set).
# Play App Signing certificate (installs from Google Play) and the upload certificate (local release builds).
ANDROID_APP_LINK_SHA256=23:18:38:73:AB:3E:65:57:7D:C0:B7:AE:65:E5:4F:22:B4:93:16:F4:00:E1:35:D3:8A:2C:C1:B6:DA:A8:78:E8,2F:19:26:8B:E8:F5:4C:A6:82:75:54:72:F8:ED:22:12:F0:EC:50:69:F1:DD:05:CF:7A:69:09:C4:C0:47:BC:C9

# fcm = real Firebase Cloud Messaging delivery (needs FCM_PROJECT_ID and the service account file below).
# log is a local development sink only; production-check reports MISSING until the live provider is configured.
PUSH_DRIVER=fcm
FCM_PROJECT_ID=pelagic-core-448613-p0
# Absolute path of the Firebase service account JSON, stored OUTSIDE the web root and the repository.
FCM_CREDENTIALS=

# ID-token audiences: the web/server client (Android + iOS request tokens for it) and the iOS client.
GOOGLE_CLIENT_IDS=413923034391-0e7qt82t4526sldrub9ohfkg1kt1ar1b.apps.googleusercontent.com,413923034391-830hqsu089ipf4ao4ivbins98bcpf1ft.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.senmiydin.app
APPLE_TEAM_ID=7YH3522U6V
APPLE_KEY_ID=F33QMU6LBH
APPLE_PRIVATE_KEY_PATH=
APPLE_SERVICE_ID=

# Operator-supplied release readiness information; no invented legal identity.
OPERATOR_NAME=
OPERATOR_CONTACT=
LEGAL_REVIEWED=false
SCHEDULER_CONFIGURED=false
QUEUE_WORKER_CONFIGURED=false
MAIL_ALLOW_UNAUTHENTICATED_RELAY=false
BRAND_FINAL=false

# Offline reverse geocoding; use none to require manual city selection.
LOCATION_CITY_PROVIDER=boundaries

# Minimum registration age. The public legal pages, the app and the store listings all state 16; change them together.
# Accounts of 16-17 (teen band) and 18+ (adult band) never interact: this is enforced on the server from the birth date.
MINIMUM_AGE=16

# "Yakınında yeni bir paylaşım var": people within this radius whose location sample is fresher than the window.
NEARBY_POST_RADIUS_METERS=1000
NEARBY_POST_FRESHNESS_MINUTES=30

# Approximate-location grids (degrees, ~55 m): private location messages and Map Notes are snapped to them on the server.
MESSAGE_LOCATION_GRID=0.0005
MAP_NOTE_LOCATION_GRID=0.0005
MAP_NOTE_NEARBY_METERS=1000

# Ads (AdMob) are controlled from Admin > Settings (ads_enabled, feed_ad_interval); the AdMob ids are MOBILE BUILD
# values (config/production.local.json via tool/configure_mobile.py), never backend secrets.
# Operator identity, address, tax/MERSIS number, KVKK contact and support e-mail are entered in Admin > Settings.
