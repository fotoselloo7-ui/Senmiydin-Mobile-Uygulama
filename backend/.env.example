APP_NAME="SenMiydin?"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://senmiydin.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

# Exact TLS-terminating proxy IPs/CIDRs; never use * on a publicly reachable origin.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=https://senmiydin.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=senmiydin
DB_USERNAME=senmiydin
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=

FILESYSTEM_DISK=local
AVATAR_DISK=local
POST_MEDIA_DISK=local
LOCATION_HISTORY_DAYS=7
SANCTUM_EXPIRATION=43200
SANCTUM_STATEFUL_DOMAINS=senmiydin.com

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids

# Use log only in local/development. Secrets belong in the deployment environment.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SenMiydin?"
PUBLIC_SITE_URL=https://senmiydin.com
PUBLIC_SUPPORT_EMAIL=

PUSH_DRIVER=log
FCM_PROJECT_ID=
FCM_CREDENTIALS=

GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.senmiydin.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_SERVICE_ID=

# Operator-supplied release readiness information; no invented legal identity.
OPERATOR_NAME=
OPERATOR_CONTACT=
LEGAL_REVIEWED=false
SCHEDULER_CONFIGURED=false
QUEUE_WORKER_CONFIGURED=false
MAIL_ALLOW_UNAUTHENTICATED_RELAY=false
BRAND_FINAL=false

# Offline reverse geocoding; use none to require manual city selection.
LOCATION_CITY_PROVIDER=boundaries
