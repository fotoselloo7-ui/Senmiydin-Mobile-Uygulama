<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android SplashScreen API theme (core-splashscreen): Android 12+ uses the system splash with this icon,
         older versions get the same layout. The surface is the brand purple of the animated splash and the icon is the same SenMiydin? mark with the
         eyes in the animation's first position (native_splash_icon.png, made from the approved artwork by
         tool/make_native_splash_icon.py), inside the 192 dp circle Android masks to. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/native_splash_icon</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- Theme of the activity once the splash is gone: also what shows behind the Flutter UI while it initialises. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
