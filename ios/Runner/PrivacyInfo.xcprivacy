<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App-level privacy manifest, derived from docs/store/APPLE_PRIVACY_LABELS.md (the code based data matrix).
  SDK manifests (Flutter, Firebase, Google Sign-In, Google Mobile Ads) are merged by Xcode on top of this file.
  It must be checked against the Xcode "Privacy Report" of the real archive on a Mac before App Store submission.
  No tracking: the app never asks for App Tracking Transparency and never reads the advertising identifier (IDFA).
  Google AdMob requests on iOS are always non-personalized; the UMP consent flow still runs where it is required.
  Teen (16-17) accounts additionally get age-restricted treatment.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key><string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key><true/>
			<key>NSPrivacyCollectedDataTypeTracking</key><false/>
			<key>NSPrivacyCollectedDataTypePurposes</key><array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
		</dict>
